# ===== Bắt buộc =====
DISCORD_TOKEN=
CLIENT_ID=
# Server dùng để deploy lệnh nhanh khi phát triển (bỏ trống = deploy global)
GUILD_ID=

# ===== Quản trị =====
# ID Discord của chủ bot, phân tách bằng dấu phẩy. Chủ bot được dùng /restore_db, /fishing-restore, /fishing-config...
OWNER_IDS=
# (Tuỳ chọn) ID role quản trị viên game, dùng được các lệnh /fishing-admin, /fishing-event, /backupdb
ADMIN_ROLE_ID=
# (Tuỳ chọn) Kênh nhận thông báo sự kiện / boss / backup
ANNOUNCE_CHANNEL_ID=
LOG_CHANNEL_ID=

# ===== Dữ liệu =====
DB_PATH=./data/fishing.sqlite
BACKUP_DIR=./backups
# auto = dùng better-sqlite3, nếu không cài được thì dùng node:sqlite (Node >= 22.5). Có thể ép: better-sqlite3 | node-sqlite
DB_DRIVER=auto

# ===== Backup tự động (có thể đổi trực tiếp trên Discord bằng /fishing-config) =====
BACKUP_INTERVAL_MIN=60
BACKUP_KEEP_AUTO=48
BACKUP_KEEP_MANUAL=15
BACKUP_MAX_AGE_DAYS=7
BACKUP_MAX_TOTAL_MB=500

# ===== Khác =====
# Múi giờ dùng cho thời gian trong ngày, daily, sự kiện (độ lệch giờ so với UTC)
TZ_OFFSET_HOURS=7
LOG_LEVEL=info
